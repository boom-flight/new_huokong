)
Alias('test_imu_calibration', test_imu_calibration)

test_imu_policy = host_test(
    'test_imu_policy',
    [
        'tests/kernel/imu/test_imu_policy.c',
        'src/kernel/imu/imu_policy.c',
        'src/modules/attitude/imu_calibration.c',
        'src/modules/attitude/mahony.c',
    ],
