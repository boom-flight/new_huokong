import os


SConsignFile(os.path.join(os.getcwd(), 'build', 'scons', 'host-tests.dblite'))

base = Environment(
    CC='cc',
    CFLAGS=['-std=c11', '-O2', '-Wall', '-Wextra', '-Werror', '-pedantic'],
    LIBS=['m'],
)


def host_test(name, sources, include_paths):
    test_env = base.Clone()
    test_env.AppendUnique(CPPPATH=include_paths)
    objects = []
    for index, source in enumerate(sources):
        target = 'build/host-tests/obj/{}/{}'.format(name, index)
        objects.append(test_env.Object(target=target, source=source))
    return test_env.Program(
        target='build/host-tests/' + name,
        source=objects,
    )


include_paths = [
    '.',
    'algorithm',
    'drivers',
    'applications',
    'protocol',
]
module_include_paths = ['src/modules']

test_timestamp_extender = host_test(
    'test_timestamp_extender',
    [
        'tests/modules/timing/test_timestamp_extender.c',
        'src/modules/timing/timestamp_extender.c',
    ],
    module_include_paths,
)
Alias('test_timestamp_extender', test_timestamp_extender)

test_bmi088 = host_test(
    'test_bmi088',
    ['tests/test_bmi088.c', 'tests/fake_bmi088_bus.c', 'drivers/bmi088.c'],
    include_paths,
)
Alias('test_bmi088', test_bmi088)

test_imu_telemetry = host_test(
    'test_imu_telemetry',
    ['tests/test_imu_telemetry.c', 'protocol/imu_telemetry.c'],
    include_paths,
)
Alias('test_imu_telemetry', test_imu_telemetry)

test_mahony = host_test(
    'test_mahony',
    ['tests/test_mahony.c', 'algorithm/mahony.c'],
    include_paths,
)
Alias('test_mahony', test_mahony)

test_imu_calibration = host_test(
    'test_imu_calibration',
    ['tests/test_imu_calibration.c', 'algorithm/imu_calibration.c'],
    include_paths,
)
Alias('test_imu_calibration', test_imu_calibration)

test_imu_service_logic = host_test(
    'test_imu_service_logic',
    [
        'tests/test_imu_service_logic.c',
        'applications/imu_service_logic.c',
        'algorithm/imu_calibration.c',
        'algorithm/mahony.c',
    ],
    include_paths,
)
Alias('test_imu_service_logic', test_imu_service_logic)

test_dma_tx_state = host_test(
    'test_dma_tx_state',
    [
        'tests/modules/transport/test_dma_tx_state.c',
        'src/modules/transport/dma_tx_state.c',
    ],
    module_include_paths,
)
Alias('test_dma_tx_state', test_dma_tx_state)
