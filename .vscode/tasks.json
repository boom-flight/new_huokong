{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}",
        "env": { "RTT_EXEC_PATH": "/usr/bin", "RTT_CC": "gcc" }
    },
    "tasks": [
        {
            "label": "firmware build + size",
            "type": "shell",
            "command": ".script/build.sh",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$gcc"
        },
        {
            "label": "rebuild clangd index",
            "type": "shell",
            "command": ".script/rebuild-index.sh",
            "problemMatcher": "$gcc"
        },
        {
            "label": "clean",
            "type": "shell",
            "command": ".script/clean.sh",
            "problemMatcher": []
        },
        {
            "label": "host tests",
            "type": "shell",
            "command": ".script/test.sh",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": "$gcc"
        },
        {
            "label": "flash STM32F103",
            "type": "shell",
            "command": ".script/flash.sh",
            "problemMatcher": []
        },
        {
            "label": "debug STM32F103",
            "type": "shell",
            "command": ".script/gdb.sh",
            "dependsOn": "firmware build + size",
            "problemMatcher": []
        },
        {
            "label": "menuconfig",
            "type": "shell",
            "command": ".script/menuconfig.sh",
            "problemMatcher": []
        },
        {
            "label": "USART1 console",
            "type": "shell",
            "command": ".script/console.sh",
            "isBackground": true,
            "problemMatcher": []
        }
    ]
}
