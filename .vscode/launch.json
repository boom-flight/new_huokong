{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32F103C8 (auto SWD + OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "serverpath": "${workspaceFolder}/tools/openocd.sh",
            "executable": "${workspaceFolder}/build/scons/firmware/huokong.elf",
            "configFiles": ["target/stm32f1x.cfg"],
            "device": "STM32F103C8",
            "svdFile": "${workspaceFolder}/.vscode/STM32F103xx.svd",
            "runToEntryPoint": "main",
            "preLaunchTask": "firmware build + size",
            "showDevDebugOutput": "none"
        },
        {
            "name": "Attach STM32F103C8 (auto SWD)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "openocd",
            "serverpath": "${workspaceFolder}/tools/openocd.sh",
            "executable": "${workspaceFolder}/build/scons/firmware/huokong.elf",
            "configFiles": ["target/stm32f1x.cfg"],
            "device": "STM32F103C8",
            "svdFile": "${workspaceFolder}/.vscode/STM32F103xx.svd"
        }
    ]
}
