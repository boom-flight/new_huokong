Import('env', 'manifest')
from building import DefineGroup
from firmware_manifest import manifest_group_settings

settings = manifest_group_settings(manifest, 'kernel', root=Dir('#').abspath)

service_env = env.Clone(BUILDERS={})
service_env.Tool('cc')
service_env.Replace(
    CFLAGS=env['CFLAGS'],
    CPPPATH=settings['include_paths'],
    CPPDEFINES=settings['defines'],
)
service_env.Append(CCFLAGS=['-std=c11', '-Wall', '-Wextra', '-Werror'])
if GetOption('cdb'):
    service_env.Tool('compilation_db')

service_object = service_env.Object(
    target='#build/scons/firmware/objects/kernel/telemetry/telemetry_service',
    source='telemetry_service.c',
)
service_group = DefineGroup(
    'Telemetry Service',
    service_object,
    depend=[],
    direct_dependencies=[
        'IMU Service',
        'IMU Telemetry',
        'Telemetry Policy',
        'STM32 Telemetry UART',
    ],
)

policy_object = service_env.Object(
    target='#build/scons/firmware/objects/kernel/telemetry/telemetry_policy',
    source='telemetry_policy.c',
)
policy_group = DefineGroup(
    'Telemetry Policy',
    policy_object,
    depend=[],
    direct_dependencies=[],
)
group = service_group + policy_group

Return('group')
