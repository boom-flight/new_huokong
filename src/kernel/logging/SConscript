Import('env', 'manifest')
from building import DefineGroup
from firmware_manifest import manifest_group_settings

settings = manifest_group_settings(manifest, 'kernel', root=Dir('#').abspath)
logging_env = env.Clone(BUILDERS={})
logging_env.Tool('cc')
logging_env.Replace(
    CFLAGS=env['CFLAGS'],
    CPPPATH=settings['include_paths'],
    CPPDEFINES=settings['defines'],
)
logging_env.Append(CCFLAGS=['-std=c11', '-Wall', '-Wextra', '-Werror'])
if GetOption('cdb'):
    logging_env.Tool('compilation_db')

logging_objects = []
for source in ['imu_log_event.c', 'imu_log_service.c']:
    logging_objects.extend(logging_env.Object(
        target='#build/scons/firmware/objects/kernel/logging/' + source[:-2],
        source=source,
    ))
group = DefineGroup(
    'IMU Logging',
    logging_objects,
    depend=[],
    direct_dependencies=['IMU Policy'],
)

Return('group')
